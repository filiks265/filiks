{
  "name": "@filiks/cli",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "bin": {
    "filiks": "./bin/filiks"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun --external '@opentui/core-*'",
    "build:binary": "bun build --compile ./src/index.tsx --outfile dist/filiks"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.40",
    "@filiks/database": "workspace:*",
    "@filiks/shared": "workspace:*",
    "@opentui/core": "^0.4.1",
    "@opentui/core-linux-x64": "^0.4.1",
    "@opentui/react": "^0.4.1",
    "ai": "^7.0.37",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.27",
    "open": "^11.0.0",
    "opentui-spinner": "^0.0.7",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.6",
    "react-router": "^8.0.1",
    "shiki": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@filiks/server": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}