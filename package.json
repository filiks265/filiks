{
    "name": "filiks",
    "version": "1.0.0",
    "workspaces": ["packages/*"],
    "scripts": {
        "dev:cli": "bun run --watch packages/cli/src/index.tsx",
        "dev:server": "bun run --hot packages/server/src/index.ts",
        "build:cli": "bun run --filter @filiks/cli build",
    "build:binary": "bun run --filter @filiks/cli build:binary",
    "link:cli": "bun run build:cli && cd packages/cli && bun link",
    "release": "bun run build:binary && gh release create"
  }
}